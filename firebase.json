{
  "hosting": {
    "public": "dist/portfolio/browser",
    "cleanUrls": true,
    "trailingSlash": false,
    "ignore": ["firebase.json", "**/.*", "**/node_modules/**", "_headers", "_redirects"],
    "redirects": [
      { "source": "/en", "destination": "/", "type": 301 },
      { "source": "/en/**", "destination": "/", "type": 301 }
    ],
    "headers": [
      { "source": "**", "headers": [{ "key": "X-Robots-Tag", "value": "noindex" }] },
      { "source": "**/*.@(js|css)", "headers": [{ "key": "Cache-Control", "value": "public, max-age=31536000, immutable" }] },
      { "source": "/resume*.md", "headers": [{ "key": "Content-Type", "value": "text/markdown; charset=utf-8" }] }
    ]
  }
}
