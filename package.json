{
  "name": "fd-portfolio",
  "version": "1.0.21",
  "private": true,
  "engines": {
    "node": ">=24.15.0"
  },
  "scripts": {
    "ng": "ng",
    "start": "ng serve",
    "watch": "ng build --watch --configuration development",
    "build": "npm run content:fetch && npm run build:site",
    "test": "ng test --watch=false",
    "content:fetch": "node scripts/content/fetch-snapshot.mjs --out src/content/snapshot.json",
    "test:scripts": "node --test \"scripts/**/*.test.mjs\"",
    "build:site": "ng build && node scripts/seo/write-discovery.mjs dist/portfolio/browser && node scripts/verify-build.mjs dist/portfolio/browser",
    "build:preview": "npm run content:fetch -- --preview && npm run build:site",
    "content:stage": "node scripts/content/apply.mjs --phase stage",
    "content:cutover": "node scripts/content/apply.mjs --phase cutover"
  },
  "dependencies": {
    "@angular/common": "^22.2.0",
    "@angular/compiler": "^22.2.0",
    "@angular/core": "^22.2.0",
    "@angular/platform-browser": "^22.2.0",
    "@angular/platform-server": "^22.2.0",
    "@angular/router": "^22.2.0",
    "@angular/ssr": "^22.2.5",
    "rxjs": "~7.8.0",
    "tslib": "^2.3.0"
  },
  "devDependencies": {
    "@angular/build": "^22.2.5",
    "@angular/cli": "^22.2.5",
    "@angular/compiler-cli": "^22.2.0",
    "@types/node": "^22.12.0",
    "firebase-admin": "^14.5.0",
    "jsdom": "^30.0.0",
    "typescript": "~6.0.2",
    "vitest": "^5.0.0"
  }
}
